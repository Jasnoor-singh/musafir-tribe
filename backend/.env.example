# Copy this file to .env and fill in real values. Never commit the real .env.
MONGODB_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/<dbname>?appName=<AppName>
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Production only
# NODE_ENV=production
# PORT=4000
# ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Optional payment gateways
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Booking emails (server-side only; never use a VITE_ prefix)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Musafir Tribe <onboarding@resend.dev>"
# Recipient is fixed to singhjasnoor1421@gmail.com in services/bookingEmail.js.
